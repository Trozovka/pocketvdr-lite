<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      No INTERNET permission here on purpose: the logging path has zero network dependency
      (see the project's non-negotiable #1). All location/foreground-service/wake-lock/battery
      permissions come from the :reliability module dependency's own manifest.
    -->

    <application>
        <service
            android:name="com.trozovka.pocketvdr.core.logging.VoyageLoggerService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>
</manifest>
